menu "Waze HUD firmware"

choice WAZE_HUD_DISPLAY_PROFILE
    prompt "Display profile"
    default WAZE_HUD_DISPLAY_TDISPLAY_S3

config WAZE_HUD_DISPLAY_TDISPLAY_S3
    bool "LILYGO T-Display S3 (320x170 landscape)"

config WAZE_HUD_DISPLAY_35_480X320
    bool "LCDWiki ES3C35P ST77922 (480x320 landscape)"
    help
        Enables the ES3C35P-specific ST77922 QSPI initialization, software
        landscape rotation, 480x320 HUD layout and matching HLP declaration.

endchoice

config WAZE_HUD_MOCK_MODE
    bool "Enable renderer mock mode"
    default n
    help
        Cycle deterministic renderer scenarios without requiring a phone.
        Minimum speed remains mock-only; lane guidance also exercises the
        real HLP/1 direction-mask representation.

config WAZE_HUD_DEFAULT_BRIGHTNESS
    int "Default backlight brightness (percent)"
    range 10 100
    default 70
    help
        Must align with the HLP configuration slider's 5 percent step.

config WAZE_HUD_HEADLESS_DIAGNOSTIC
    bool "Disable LCD/UI for watchdog isolation"
    default n
    help
        Keep BLE, HLP, state and configuration active while skipping display
        initialization and the UI task. Intended only for hardware diagnosis.

config WAZE_HUD_UI_TASK_CORE
    int "UI task core"
    range 0 1
    default 1

endmenu
